#!/usr/bin/env python3
"""Show DeepSeek API balance and percent relative to a recorded baseline."""

from __future__ import annotations

import argparse
from decimal import Decimal, InvalidOperation
import json
import os
from pathlib import Path
import sys
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


ROOT = Path(__file__).resolve().parents[1]
BASELINE_PATH = ROOT / "state" / "balance_baseline.json"
BALANCE_URL = "https://api.deepseek.com/user/balance"
DEFAULT_KEY_FILE = Path("/home/hgff/api deepseek.txt")


class BalanceError(Exception):
    pass


def api_key() -> str:
    key = os.environ.get("DEEPSEEK_API_KEY", "").strip()
    if not key:
        path = Path(os.environ.get("DEEPSEEK_KEY_FILE", str(DEFAULT_KEY_FILE)))
        try:
            key = path.read_text(encoding="utf-8").strip()
        except OSError as error:
            raise BalanceError(f"cannot read DeepSeek API key file: {path}") from error
    if not key.startswith("sk-") or "\n" in key:
        raise BalanceError("DeepSeek API key format is invalid")
    return key


def fetch_balance(key: str) -> dict:
    request = Request(BALANCE_URL, headers={"Authorization": f"Bearer {key}"})
    try:
        with urlopen(request, timeout=20) as response:
            payload = json.load(response)
    except HTTPError as error:
        raise BalanceError(f"DeepSeek balance API returned HTTP {error.code}") from error
    except (URLError, TimeoutError, json.JSONDecodeError) as error:
        raise BalanceError(f"DeepSeek balance API request failed: {type(error).__name__}") from error
    if not isinstance(payload, dict) or not isinstance(payload.get("balance_infos"), list):
        raise BalanceError("DeepSeek balance API returned an invalid response")
    return payload


def amounts(payload: dict) -> dict[str, Decimal]:
    found: dict[str, Decimal] = {}
    for item in payload["balance_infos"]:
        try:
            currency = item["currency"]
            value = Decimal(item["total_balance"])
        except (KeyError, TypeError, InvalidOperation) as error:
            raise BalanceError("DeepSeek balance API returned an invalid amount") from error
        if currency not in ("USD", "CNY") or not value.is_finite() or value < 0:
            raise BalanceError("DeepSeek balance API returned an invalid currency or amount")
        if currency in found:
            raise BalanceError(f"DeepSeek balance API returned duplicate currency: {currency}")
        found[currency] = value
    if not found:
        raise BalanceError("DeepSeek balance API returned no balances")
    return found


def read_baseline() -> dict[str, Decimal]:
    if not BASELINE_PATH.is_file():
        return {}
    try:
        data = json.loads(BASELINE_PATH.read_text(encoding="utf-8"))
        return {currency: Decimal(value) for currency, value in data["amounts"].items()}
    except (OSError, KeyError, ValueError, TypeError, InvalidOperation) as error:
        raise BalanceError(f"invalid baseline file: {BASELINE_PATH}") from error


def write_baseline(values: dict[str, Decimal]) -> None:
    BASELINE_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    BASELINE_PATH.parent.chmod(0o700)
    temporary = BASELINE_PATH.with_name(BASELINE_PATH.name + ".tmp")
    temporary.write_text(
        json.dumps({"captured_at": int(time.time()),
                    "amounts": {key: str(value) for key, value in values.items()}}, indent=2) + "\n",
        encoding="utf-8",
    )
    temporary.chmod(0o600)
    os.replace(temporary, BASELINE_PATH)


def report(payload: dict, current: dict[str, Decimal], baseline: dict[str, Decimal]) -> dict:
    rows = []
    for currency, available in sorted(current.items()):
        initial = baseline.get(currency)
        percentage = None
        if initial is not None:
            percentage = Decimal(0) if initial == 0 else available * 100 / initial
        rows.append({
            "currency": currency,
            "available": str(available),
            "baseline": str(initial) if initial is not None else None,
            "remaining_percent_of_baseline": (
                str(percentage.quantize(Decimal("0.01"))) if percentage is not None else None
            ),
        })
    return {
        "source": "DeepSeek GET /user/balance",
        "is_available": payload.get("is_available"),
        "baseline_note": "Percentage compares current balance with the recorded baseline, not a provider quota.",
        "balances": rows,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--reset-baseline", action="store_true",
                        help="set current balance as the new 100%% baseline")
    args = parser.parse_args(argv)
    try:
        payload = fetch_balance(api_key())
        current = amounts(payload)
        baseline = read_baseline()
        if args.reset_baseline or not baseline:
            write_baseline(current)
            baseline = current
        result = report(payload, current, baseline)
    except BalanceError as error:
        print(f"balance: {error}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(f"DeepSeek API balance: {'available' if result['is_available'] else 'unavailable'}")
        for row in result["balances"]:
            percent = row["remaining_percent_of_baseline"]
            percent_text = f"{percent}% of recorded baseline" if percent is not None else "baseline unavailable"
            print(f"{row['currency']}: {row['available']} remaining ({percent_text})")
        print(result["baseline_note"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
